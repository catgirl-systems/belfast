# 20016: SC_11702 of official-avrora-20261024-122439.jsonl
ins_message_list: {
  id:  20016
  time:  1792702800
  text:  "You've probably all noticed an increase in strange happenings lately.\nShadows that disappear suddenly, floating Jack-o'-lanterns, occasional whispering voices...\nThese are all normal, so please rest assured. They're all tricks for the Halloween event.\nThere's no need to avoid them, try to fix them, or run from them. Most people will get used to them eventually. I hope you will too."
  picture:  "https://blhxusstatic.yo-star.com/pic/261022_OA16bigyTm6ZiAcwdhexArw.png"
  player_discuss:  {
    id:  20016
    time:  0
    text_list:  "Did everyone's accounts get hacked?"
    text_list:  "Some of you haven't adapted so well..."
    text:  ""
  }
  npc_discuss:  {
    id:  100541
    time:  1792707060
    text:  "Wait, there ARE still people here who haven't lost their minds yet, right?!"
    npc_reply:  100542
  }
  npc_discuss:  {
    id:  100539
    time:  1792706700
    text:  "Uh huh! It doesn't matter that you've lost something when you don't care!"
    npc_reply:  100540
  }
  npc_discuss:  {
    id:  100536
    time:  1792706280
    text:  "My shadow seems to have vanished... But somehow, I feel fine?"
    npc_reply:  100537
    npc_reply:  100538
  }
  npc_discuss:  {
    id:  100532
    time:  1792705560
    text:  "Let me give it a whirl! @everyone"
    npc_reply:  100533
    npc_reply:  100534
    npc_reply:  100535
  }
  npc_discuss:  {
    id:  100529
    time:  1792705020
    text:  "I want every sane ship seeing these replies to be careful! Do not answer if you hear a voice calling your name! Do not answer!"
    npc_reply:  100530
    npc_reply:  100531
  }
  npc_discuss:  {
    id:  100528
    time:  1792704780
    text:  "The whispers have begun to respond to me... It feels as though there are droves of people around me... I find it comforting..."
  }
  npc_discuss:  {
    id:  100525
    time:  1792704180
    text:  "U-um, I feel like someone's been whispering my name... That's normal too, right?"
    npc_reply:  100526
    npc_reply:  100527
  }
  npc_discuss:  {
    id:  100524
    time:  1792704000
    text:  "You have to eat the extra candy at your door the same daaay... The taste changes if you leave it overnight."
  }
  npc_discuss:  {
    id:  100522
    time:  1792703520
    text:  "There was no one outside the door! BUT there was candy! And now it's mine. This is great!"
    npc_reply:  100523
  }
  npc_discuss:  {
    id:  100521
    time:  1792703400
    text:  "Just ignore the floating pumpkins! You don't want to ruin the party atmosphere♪"
  }
  npc_discuss:  {
    id:  100520
    time:  1792703280
    text:  "Just need everyone to know I was here before this blows up~"
  }
  npc_discuss:  {
    id:  100518
    time:  1792702920
    text:  "waaah everyones so into this im too scared to look at the comments"
    npc_reply:  100519
  }
  npc_reply:  {
    id:  100542
    time:  1792707180
    text:  "Analysis completed. On. Associated ships. No. Anomalies. Found."
  }
  npc_reply:  {
    id:  100540
    time:  1792706940
    text:  "It stops being scary once you get used to it too. And when it stops being scary, it's even easier to get used to it... Hehe~"
  }
  npc_reply:  {
    id:  100538
    time:  1792706580
    text:  "I actually feel like things are more convenient now. I can finally walk through the town openly without people calling me an outcast. Heehee♪"
