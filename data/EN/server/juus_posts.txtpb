ins_message_list: {
  id: 20013
  time: 1788555600
  text: "Today marks the establishment of the Port Happiness and Peace of Mind Committee!\nAccording to our intel, surveys have been distributed to residents of the port! They cover various aspects of daily life, culinary satisfaction, sleeping arrangements, entertainment, facilities, and more, with the aim of understanding everybody's sources of happiness and worry alike!\nIf you receive a survey, please answer it sincerely! Your wish is our command."
  picture: "https://blhxusstatic.yo-star.com/pic/260904_OA13bigsdAygMVb481n9ng0.png"
  player_discuss: {
    id: 20013
    time: 0
    text_list: "I'll do my best to make everyone happy."
    text_list: "Great work. I've submitted my response."
    text: ""
  }
  npc_discuss: {
    id: 100420
    time: 1788559200
    text: "My worries? That would be how the Commander won't drink my milk~"
    npc_reply: 100421
    npc_reply: 100422
  }
  npc_discuss: {
    id: 100417
    time: 1788558660
    text: "Please add a question asking if we know the hidden secrets of the port! I'll answer honestly~"
    npc_reply: 100418
    npc_reply: 100419
  }
  npc_discuss: {
    id: 100415
    time: 1788558180
    text: "Wait, that thing I got was a happiness survey?"
    npc_reply: 100416
  }
  npc_discuss: {
    id: 100414
    time: 1788558000
    text: "Can you open the underground warehouse for tours next weekend? That sure would make me happy!"
  }
  npc_discuss: {
    id: 100410
    time: 1788557340
    text: "Before I fill this out, can we define \"happiness\"?"
    npc_reply: 100411
    npc_reply: 100412
    npc_reply: 100413
  }
  npc_discuss: {
    id: 100407
    time: 1788556800
    text: "If this is a serious inquiry, then I will respond truthfully and thoroughly."
    npc_reply: 100408
    npc_reply: 100409
  }
  npc_discuss: {
    id: 100405
    time: 1788556440
    text: "Hold it! Ausburne isn't a member of the PHPMC!"
    npc_reply: 100406
  }
  npc_discuss: {
    id: 100403
    time: 1788556020
    text: "If I write \"more holidays with my Owner\" in the Other section, will I get extra attention?"
    npc_reply: 100404
  }
  npc_discuss: {
    id: 100401
    time: 1788555720
    text: "What's with the sudden interrogation? Suspicious... Wait, is this some kind of loyalty test?!"
    npc_reply: 100402
  }
  npc_reply: {
    id: 100422
    time: 1788559620
    text: "You'd better listen to them, Commander. Drinking milk and getting ample sleep are good for you."
  }
  npc_reply: {
    id: 100421
    time: 1788559440
    text: "Drinking milk... makes you taller! Teacher... Be good!"
  }
  npc_reply: {
    id: 100419
    time: 1788559020
    text: "Um... Seconded?"
  }
  npc_reply: {
    id: 100418
    time: 1788558900
    text: "Can you please make the responses public?"
  }
  npc_reply: {
    id: 100416
    time: 1788558420
    text: "To be honest, I stopped reading as soon as I saw that I'd get paid to fill it out..."
  }
  npc_reply: {
    id: 100413
    time: 1788557880
    text: "I made a lavish sea urchin feast! Let's all eat it together!"
  }
  npc_reply: {
    id: 100412
    time: 1788557700
    text: "Yeah, what WILL we eat?"
  }
  npc_reply: {
    id: 100411
    time: 1788557520
    text: "I think it means what we'll eat for our next meal, right?"
  }
  npc_reply: {
    id: 100409
    time: 1788557100
    text: "Can you add more space in the response sections? There's nowhere near enough space for me as-is."
  }
  npc_reply: {
    id: 100408
    time: 1788556980
    text: "I can also attach a list of suggestions, should you require it."
  }
  npc_reply: {
    id: 100406
    time: 1788556560
    text: "We take our work very seriously. Please help us out, everyone!"
  }
  npc_reply: {
    id: 100404
    time: 1788556200
    text: "Noted!"
  }
  npc_reply: {
    id: 100402
    time: 1788555900
    text: "Noted!"
  }
