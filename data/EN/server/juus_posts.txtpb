    npc_reply: 100216
    npc_reply: 100217
    npc_reply: 100218
  }
  npc_discuss: {
    id: 100214
    time: 1781218800
    text: "Has anyone seen my pan? I only found a note with a picture of a volcano on it when I checked the usual spot!"
