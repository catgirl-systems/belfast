  npc_discuss: {
    id: 100203
    time: 1781216760
    text: "I didn't realise adventuring could be so harrowing. I thought it was nothing more than firing one's main gun."
    npc_reply: 100204
    npc_reply: 100205
    npc_reply: 100206
  }
  npc_discuss: {
    id: 100202
    time: 1781216580
    text: "Give me a heads-up next time you're going to the volcano. I'll buy you some heat-resistant hiking boots!"
