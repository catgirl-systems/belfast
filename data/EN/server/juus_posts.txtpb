    time: 1783623420
    text: "Wait, am I reading this right? Fu Shun and Fei Yuen are being cautious?!"
  }
  npc_reply: {
    id: 100282
    time: 1783623300
    text: "That's very smart. I wish my sisters thought like you. Then they wouldn't worry me so much."
