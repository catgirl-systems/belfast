ins_message_list: {
  id: 670
  time: 1788989100
  text: "Let's skip the formalities. As they say, shut up and take my money!"
  picture: "https://blhxusstatic.yo-star.com/pic/260908_antum47khkGBLgnkajkq.png"
  player_discuss: {
