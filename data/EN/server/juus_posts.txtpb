  npc_discuss: {
    id: 100271
    time: 1783621680
    text: "Quit coming to me, all of you! I'm never gonna tell! Ooh..."
  }
  npc_discuss: {
    id: 100267
    time: 1783620900
    text: "I remember... Radford was in her bed the other day, but then she suddenly got up to go brush her teeth..."
