    text: "Has anyone actually secured a ticket? They sold out as soon as they went live, and now my schedule is a mess..."
    npc_reply: 100346
    npc_reply: 100347
    npc_reply: 100348
    npc_reply: 100349
    npc_reply: 100350
    npc_reply: 100351
    npc_reply: 100352
  }
  npc_discuss: {
    id: 100339
    time: 1786042080
    text: "Ha-ha-haah! The Northern Parliament team will be the last one standing!"
    npc_reply: 100340
    npc_reply: 100341
    npc_reply: 100342
    npc_reply: 100343
    npc_reply: 100344
  }
  npc_discuss: {
    id: 100336
    time: 1786041600
    text: "I'm gonna give it everything I've got this time to get that fourth place!"
    npc_reply: 100337
    npc_reply: 100338
  }
  npc_discuss: {
    id: 100332
    time: 1786040940
    text: "Is there any team that will have me? I promise not to cause any trouble this time round..."
    npc_reply: 100333
    npc_reply: 100334
    npc_reply: 100335
  }
  npc_discuss: {
    id: 100328
    time: 1786040280
    text: "Calling all elite racers for Team Thunderheart! Anyone wanna enter with me?"
    npc_reply: 100329
    npc_reply: 100330
    npc_reply: 100331
  }
  npc_discuss: {
    id: 100325
    time: 1786039680
    text: "I'm leading the Eagle Union team, so let me know if you want in!"
    npc_reply: 100326
    npc_reply: 100327
  }
  npc_discuss: {
    id: 100324
    time: 1786039440
    text: "We're looking forward to your participation!"
  }
  npc_reply: {
    id: 100356
    time: 1786044840
    text: "Is this... the legendary pay-to-work scheme?"
  }
  npc_reply: {
    id: 100355
    time: 1786044720
    text: "I'm not reselling anything, nya! I just wanted to help people get hired as part-time staff at the event! For a fee, nya..."
  }
  npc_reply: {
    id: 100354
    time: 1786044540
    text: "Any form of ticket reselling will be strictly punished by the event organizer."
  }
  npc_reply: {
    id: 100352
    time: 1786044180
    text: "You mean it?! Thank you!"
  }
  npc_reply: {
    id: 100351
    time: 1786044000
    text: "So I saved up a little cash to become a sponsor and get a box seat. There's still space if you want to join me, Zenker."
  }
  npc_reply: {
    id: 100350
    time: 1786043820
    text: "No, I missed out too."
  }
  npc_reply: {
    id: 100349
    time: 1786043640
    text: "Am I the ONLY one who didn't get a ticket?"
  }
  npc_reply: {
    id: 100348
    time: 1786043520
    text: "I got one easy thanks to the machine I made that can tap ten phones at once♪"
  }
  npc_reply: {
    id: 100347
    time: 1786043400
    text: "I must've tapped my phone with my face while I slept, I had a ticket when I woke up"
  }
  npc_reply: {
    id: 100346
    time: 1786043280
    text: "Griffy nabbed mine for me! She's super fast!"
  }
  npc_reply: {
    id: 100344
    time: 1786042860
    text: "Are you kidding me?! Do you know how much work I put into that car? IT'S PERFECT!!"
  }
  npc_reply: {
    id: 100343
    time: 1786042620
    text: "A three-wheeled vehicle doesn't comply with the regulations."
  }
  npc_reply: {
    id: 100342
    time: 1786042500
    text: "Sorry to interrupt when you're so excited, but I'm afraid the Northern Parliament's car didn't pass inspection."
  }
  npc_reply: {
    id: 100341
    time: 1786042320
    text: "I equipped it with a detonation-powered propulsion unit, super alloy deflectors, AND a punching robot to stop you falling asleep at the wheel!"
  }
  npc_reply: {
    id: 100340
    time: 1786042200
    text: "You said it! The ultra-battle car we put together is the GREATEST!"
  }
  npc_reply: {
    id: 100338
    time: 1786041960
    text: "Mmm, but fourth's more symbolic! You should go for that top spot, Cleveland!"
  }
  npc_reply: {
    id: 100337
    time: 1786041720
    text: "Aren't you meant to aim for first? :o"
  }
  npc_reply: {
    id: 100335
    time: 1786041480
    text: "I keep telling you! I'm not a demon!"
  }
  npc_reply: {
    id: 100334
    time: 1786041300
    text: "Barrier expansion complete! She won't get away this time!"
  }
  npc_reply: {
    id: 100333
    time: 1786041180
    text: "Here comes the vehicle-destroying demon! Quickly, seal her away!"
  }
  npc_reply: {
    id: 100331
    time: 1786040700
    text: "Doesn't say anywhere that you gotta DRIVE the car! I’m just gonna carry it and run!"
  }
  npc_reply: {
    id: 100330
    time: 1786040580
    text: "Don't sweat it! Neither can I!"
  }
  npc_reply: {
    id: 100329
    time: 1786040400
    text: "I want to take part with everyone... but I can't drive..."
  }
  npc_reply: {
    id: 100327
    time: 1786040040
    text: "Of course you are. Teams can be made up of members from different factions."
  }
  npc_reply: {
    id: 100326
    time: 1786039800
    text: "Am I okay to apply?"
  }
