"1001":{"born_object":10010064,"camera_zoom":[0.5,1,0.5],"default_bgm":"story-richang-10","desc":"中央沃土，良田與牧場交織如錦。這豐饒的腹地是島嶼生生不息的食物之源。","id":1001,"loading":0,"minigame_id":0,"name":"晨露農場","save_transform":1,"sceneName":"Island/ScenesRes/Scenes/Ranch/map_xyd_ranch","time":"always"},
"1002":{"born_object":10020001,"camera_zoom":[0.5,1,0.5],"default_bgm":"story-richang-2","desc":"南岸明珠，深水良港吞吐不息。繁忙碼頭與飄香咖啡館比鄰，高效的物流箱上暈染著溫暖的人間煙火色。","id":1002,"loading":0,"minigame_id":0,"name":"港口","save_transform":1,"sceneName":"Island/ScenesRes/Scenes/Fishery/map_xyd_fishery","time":"always"},
"1003":{"born_object":10030001,"camera_zoom":[0.5,1,0.5],"default_bgm":"theme-myisland","desc":"主島之外，一片封閉的空間特殊區域。僅在此處，海風將會帶來遠方的問候，並將問候的資訊傳向遠方。","id":1003,"loading":1,"minigame_id":0,"name":"集會島 ","save_transform":1,"sceneName":"Island/ScenesRes/Scenes/jhs_autumn/map_jhs_autumn","time":"always"},
"1004":{"born_object":10040024,"camera_zoom":[0.5,1,0.5],"default_bgm":"story-richang-10","desc":"西隅之境，蓊鬱喬木掩映著沉睡的礦藏。長久以來，這片豐饒的野地一直以不竭的林木與礦石，為島嶼的發展注入最為澎湃的動力。","id":1004,"loading":0,"minigame_id":0,"name":"棲風原野","save_transform":1,"sceneName":"Island/ScenesRes/Scenes/Fell/map_xyd_fell","time":"always"},
"1005":{"born_object":10050001,"camera_zoom":[0.5,1,0.5],"default_bgm":"story-richang-10","desc":"北麓向陽，果園芬芳，苗圃蔥綠。陽光眷顧處，自然的豐沛孕育著甜蜜果實與盎然生機。","id":1005,"loading":0,"minigame_id":0,"name":"繁蔭農圃","save_transform":1,"sceneName":"Island/ScenesRes/Scenes/Orchard/map_xyd_orchard","time":"always"},
"1006":{"born_object":10060001,"camera_zoom":[0.5,1,0.5],"default_bgm":"story-richang-6","desc":"重要商區，八方風味匯聚一堂。美食琳琅，煙火升騰，這裡是島嶼最繁華熱鬧的休閒之所。","id":1006,"loading":0,"minigame_id":0,"name":"港口商區 ","save_transform":1,"sceneName":"Island/ScenesRes/Scenes/Commercial/map_xyd_commercial","time":"always"},
"1007":{"born_object":10070001,"camera_zoom":[0.5,1,0.5],"default_bgm":"story-richang-9","desc":"島嶼核心，工廠的轟鳴聲與智慧的火花共舞，尖端科技研發在此進行，高效的產能與創新的活力相生相長——但，是秘密基地。","id":1007,"loading":0,"minigame_id":0,"name":"島嶼基地","save_transform":1,"sceneName":"island/scenesres/scenes/factory/map_xyd_factory_01","time":"always"},
